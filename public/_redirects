# Cloudflare Pages (static export). The detail screens are built once, as "_".
# Every /<list>/<id>/ is served by that screen (200 = the address stays the same), and the screen reads the
# real id from the address bar. /<list>/<id>/* covers the small data files Next loads when moving between pages.
# The first rule that matches wins, so the real pages (like /orders/new/) come first.

# The old shop owners' page: their landing page is now the shops' app.
/shops  /client  301
/shops/  /client  301

# The phone apps' detail screens (same trick as below, inside /client and /driver).
/client/orders/:id/*  /client/orders/_/:splat  200
/client/orders/:id/  /client/orders/_/  200
/client/orders/:id  /client/orders/_/  200
/client/invoices/:id/*  /client/invoices/_/:splat  200
/client/invoices/:id/  /client/invoices/_/  200
/client/invoices/:id  /client/invoices/_/  200
/client/returns/:id/*  /client/returns/_/:splat  200
/client/returns/:id/  /client/returns/_/  200
/client/returns/:id  /client/returns/_/  200
/driver/orders/new  /driver/orders/new/  200
/driver/orders/new/*  /driver/orders/new/:splat  200
/driver/returns/new  /driver/returns/new/  200
/driver/returns/new/*  /driver/returns/new/:splat  200
/driver/payments/new  /driver/payments/new/  200
/driver/payments/new/*  /driver/payments/new/:splat  200
/driver/orders/:id/*  /driver/orders/_/:splat  200
/driver/orders/:id/  /driver/orders/_/  200
/driver/orders/:id  /driver/orders/_/  200
/driver/invoices/:id/*  /driver/invoices/_/:splat  200

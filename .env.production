# The live site's settings (Cloudflare Pages, aln.ama8.uk). Next reads this file on every production build
# (`next build`, `npm run build:pages`), whatever the host's own settings are; `npm run dev` doesn't read it.
# Nothing secret here: everything starting with NEXT_PUBLIC_ is visible in the browser.
# A variable set in the build's environment still wins (e.g. NEXT_PUBLIC_USE_MOCK=true for a demo build).

# The real backend (without /api/v1: it is added)
NEXT_PUBLIC_API_URL=https://api.ama8.uk

# false = call the real API (true = the demo data in the browser)
NEXT_PUBLIC_USE_MOCK=false

# Live updates (WebSocket)
NEXT_PUBLIC_WS_URL=wss://api.ama8.uk/ws

# Copy this file to .env and change the values.
# .env is ignored by git. Never put secrets here:
# everything starting with NEXT_PUBLIC_ is visible in the browser.

# Base URL of the backend API, without /api/v1 (it is added; given with it, it is cut off)
NEXT_PUBLIC_API_URL=https://api.ama8.uk/

# true  = use fake data from lib/api/mock.ts (while the backend is not ready)
# false = call the real API
# Restart `npm run dev` after changing this.
NEXT_PUBLIC_USE_MOCK=false

# Live updates (WebSocket), see docs/realtime.md. Empty = only between the tabs of one browser.
# To try between devices: `npm run realtime`, then NEXT_PUBLIC_WS_URL=ws://localhost:8787
NEXT_PUBLIC_WS_URL=wss://api.ama8.uk/ws
